# Zeitzone
TZ=Europe/Vienna

# Server & Home Assistant Konfiguration
PORT=3000
HA_URL=http://192.168.0.2:8123
HA_TOKEN=dein_long_lived_access_token_hier

# Explizite ID des Conversation Agent in HA (z.B. conversation.google_generative_ai)
CONVERSATION_AGENT=conversation.google_generative_ai

# Erlaubte Nutzer (Format: "Nummer:Name", mehrere mit Komma trennen)
ALLOWED_USERS=436***:Marco,43***:Brigitte
ADMIN_NUMBER=436***

# WAHA WhatsApp HTTP API (externer Container, siehe docker-compose.yaml)
WAHA_URL=http://waha:3000
WAHA_API_KEY=dein_langer_zufaelliger_api_key
WAHA_SESSION=default
# URL, unter der WAHA diese Bridge erreicht (Events: message, poll.vote, session.status)
WAHA_WEBHOOK_URL=http://whatsapp-ha-bridge:3000/waha/webhook

# Gruppen (gleiches Format: "Gruppen-JID:Name", IDs via /groups vom Bot)
# GROUP_IDS=120363012345678@g.us:Familie,120363098765432@g.us:Team