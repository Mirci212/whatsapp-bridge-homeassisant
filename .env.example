# Kopieren nach `.env` und Werte eintragen: cp .env.example .env
# (.env ist in .gitignore und wird nie committed.)

# Home Assistant
HA_URL=http://192.168.0.2:8123
HA_TOKEN=dein_long_lived_access_token
CONVERSATION_AGENT=conversation.gemini_live
STT_ENGINE=stt.faster_whisper

# WhatsApp Nutzer (Format "Nummer:Name", mehrere mit Komma trennen)
ALLOWED_USERS=436641234567:Marco,436649876543:Brigitte
ADMIN_NUMBER=436641234567
# Gruppen (Format "Gruppen-JID:Name", IDs liefert der Bot per /groups)
GROUP_IDS=120363012345678@g.us:Familie

# WAHA (langer Zufalls-Key, z.B. per: openssl rand -hex 32)
WAHA_API_KEY=hier_einen_langen_zufaelligen_key_eintragen

# WAHA Dashboard-Login (http://<host>:3100/dashboard)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=hier_ein_eigenes_dashboard_passwort_eintragen
